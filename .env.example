# GCL Framework - Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM API Keys (for Experiment 11: LLM Drift Calibration)
# =============================================================================

# OpenAI API Key (required for embeddings and GPT-4)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Anthropic API Key (required for Claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# =============================================================================
# Usage
# =============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env and paste your actual API keys
#
# 3. Run the calibration experiment:
#    python experiments/11_llm_drift_calibration.py
#
# Cost estimate: ~$5-15 for full experiment
